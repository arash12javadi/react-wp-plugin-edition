{
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/plugins/:path*",
      "destination": "/api/plugins?__path=:path*"
    },
    {
      "source": "/api/v1/licenses/revoked",
      "destination": "/api/plugins?__path=rwp-plugin-marketplace/licenses/revoked"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**": {
      "includeFiles": "plugin-sources/**",
      "maxDuration": 60
    }
  }
}
